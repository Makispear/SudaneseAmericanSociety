# =====================================================================
# 1. ENVIRONMENT VARIABLES & CREDENTIALS (CRITICAL FOR SECURITY)
# =====================================================================
.env
.env.local
.env.*.local
*.env
*.pem
*.key
certs/
secrets/

# =====================================================================
# 2. DEPENDENCIES & RUNTIME (PREVENTS COMMITTING BULKY FILES)
# =====================================================================
node_modules/
jspm_packages/
web_modules/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# 3. BUILD, DIST, AND CACHE OUTPUTS
# =====================================================================
dist/
build/
.cache/
.parcel-cache/
.turbo/
out/

# =====================================================================
# 4. OPERATING SYSTEM FILES (CLEANS UP SYSTEM JUNK)
# =====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# =====================================================================
# 5. IDEs AND TEXT EDITORS
# =====================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

.env*
.flaskenv*
!.env.project
!.env.vault